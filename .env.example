DATABASE_URL=postgresql://username:password@host/database?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Must use an address on a domain you verify in Resend.
RESEND_FROM_EMAIL="BlackArrow Insurance <forms@blackarrow.co>"

# ---- Monthly auto-post cron job ----
# Bearer token Vercel Cron uses to authenticate /api/cron/generate-monthly-post.
# Generate a strong random value (e.g. `openssl rand -hex 32`) and set it in Vercel project env vars.
CRON_SECRET=replace_with_openssl_rand_hex_32

# Claude API key used to generate monthly NC blog posts. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx

# Optional: set to "true" to auto-publish. Any other value (or unset) saves the post as a draft.
AUTO_PUBLISH_POSTS=false

# Optional: user id to attribute auto-generated posts to. Leave empty for null author.
AUTO_POST_AUTHOR_ID=

# Optional: override the Anthropic model used for generation.
AUTO_POST_MODEL=claude-sonnet-4-6

# ---- Forms: spam protection (reCAPTCHA v3) ----
# Public site key (safe to expose) and server secret for verification.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Analytics & attribution (Phase 1) ----
# GA4 measurement id, e.g. "G-XXXXXXXXXX". Leave empty to disable GA entirely.
# When set, a consent banner gates it (see NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Ahrefs Web Analytics public key (cookieless). Defaults to the live key in code.
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=
# "false" to load GA without a consent prompt; any other value requires consent.
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true
# Client-readable mirror of Vercel's VERCEL_ENV so preview/dev don't send
# analytics to production. Set to "$VERCEL_ENV" in Vercel project settings.
NEXT_PUBLIC_VERCEL_ENV=

# ---- Search engine site verification (Phase 1) ----
# Verification tokens rendered into <head>. Leave empty until verified.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
